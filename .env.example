# ProjectFlow Environment Variables

# JWT Authentication
JWT_SECRET="projectflow-super-secure-jwt-secret-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"

# File Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# TiDB Cloud (Serverless / Distributed MySQL) Configuration
# Connection URI: mysql://2zWeNSGrm7sUDKF.root:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/sys
TIDB_HOST="gateway01.ap-southeast-1.prod.aws.tidbcloud.com"
TIDB_PORT=4000
TIDB_USER="2zWeNSGrm7sUDKF.root"
TIDB_PASSWORD="YOUR_TIDB_CLOUD_PASSWORD"
TIDB_DATABASE="sys"

# GEMINI_API_KEY: Provided by AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
